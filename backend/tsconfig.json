{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src",
    "lessons/tools.js",
    "lessons/runnable.ts",
    "lessons/index.ts",
    "lessons/graph.ts",
    "added/briefing-doc.ts",
    "added/mindMap.ts",
    "added/study-guide.ts",
    "src/pipelines/summary.ts"
  ],
  "exclude": ["node_modules"]
}
